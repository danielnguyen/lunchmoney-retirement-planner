LUNCHMONEY_API_TOKEN=replace-with-a-server-side-read-only-token
PLANNER_CONFIG_PATH=config/planner.local.yaml
PLANNER_CONFIG_WRITE_ENABLED=false
NEXT_PUBLIC_APP_NAME=Retirement Planner

# Optional dedicated credential for GET /api/v1/exports/projection only.
